#*************************************************************************
# Open Embedded default definitions
#*************************************************************************
#   author		  	: Jeong Han Lee
#   							: Jerzy Jamroz
#		date					: 13.10.2024
#*************************************************************************
# Define the site variables:
## OECORE_TARGET_SYSROOT - Target sysroot directory
## OECORE_NATIVE_SYSROOT - SDK toolchain directory
## GNU_TARGET - Define if T_A not equal GNU_TARGET
#*************************************************************************

# Common flags
ARCH_DEP_CPPFLAGS += --sysroot=$(OECORE_TARGET_SYSROOT)
ARCH_DEP_CPPFLAGS += -pipe -feliminate-unused-debug-types
ARCH_DEP_CXXFLAGS += -std=c++17

ARCH_DEP_LDFLAGS  += --sysroot=$(OECORE_TARGET_SYSROOT)
ARCH_DEP_LDFLAGS  += -Wl,-O3
ARCH_DEP_LDFLAGS  += -Wl,--hash-style=gnu
ARCH_DEP_LDFLAGS  += -Wl,--as-needed

GNU_TARGET ?= $(subst -debug,,$(T_A))
GNU_DIR = $(OECORE_NATIVE_SYSROOT)/usr
#Toolchain has the GNU_TARGET after bin
GNU_BIN = $(GNU_DIR)/bin/$(GNU_TARGET)

COMMANDLINE_LIBRARY ?= READLINE
# For eventual future expansion
PYTHONHOME ?= $(OECORE_NATIVE_SYSROOT)/usr/bin
